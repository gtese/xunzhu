# edu-tutor 环境配置 — 权限 600，不入仓库、不入对话
# 生成时间: 2026-11-27
PUBLIC_BASE_URL=https://edu.v2txt.cn:52066

# ---- PostgreSQL (pgvector) ----
POSTGRES_DB=edu_tutor
POSTGRES_USER=edu
POSTGRES_PASSWORD=__CHANGE_ME__

# ---- Redis ----
REDIS_PASSWORD=__CHANGE_ME__

# ---- MinIO ----
MINIO_ROOT_USER=__DEPRECATED__
MINIO_ROOT_PASSWORD=__DEPRECATED__
MINIO_BUCKET=edu-files

# ---- 阿里云百炼 DashScope ----
DASHSCOPE_API_KEY=__CHANGE_ME__
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
VLM_MODEL=qwen-vl-max
OCR_MODEL=qwen-vl-ocr

# ---- 飞书自建应用（待创建后填写）----
FEISHU_APP_ID=__CHANGE_ME__
FEISHU_APP_SECRET=__CHANGE_ME__
FEISHU_REDIRECT_URI=https://edu.v2txt.cn:52066/api/auth/feishu/callback

# ---- 应用密钥 ----
APP_SECRET_KEY=__CHANGE_ME__
APP_ENV=production

# ---- 文件存储（MinIO 社区镜像已下架，改用本地卷；STORAGE_BACKEND=s3 时切 Garage/MinIO）----
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/opt/edu-tutor/data/files
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=edu-files
